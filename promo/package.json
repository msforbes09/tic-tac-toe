{
  "name": "tic-tac-toe-promo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "remotion studio",
    "render": "npm run render:reel && npm run render:square",
    "render:reel": "remotion render Promo out/reel.mp4 --props='{\"layout\":\"reel\"}'",
    "render:square": "remotion render Promo out/square.mp4 --props='{\"layout\":\"square\"}'",
    "voice": "node --env-file=.env scripts/voice.ts",
    "tones": "node scripts/tones.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@remotion/cli": "4.0.531",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.531"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
